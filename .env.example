# Copy to settings.env for local use. Never commit settings.env.
# Process environment variables take priority. Vercel ignores local env files.
HOST=127.0.0.1
PORT=8000
# Choose a NEW unique private password of 16-256 characters. No default exists.
ADMIN_PIN=
# Required on Vercel. Use a pooled PostgreSQL connection string with TLS.
# Leave blank for local JSON storage.
DATABASE_URL=
SALON_EMAIL=
STUDIO_PHONE=
AUTO_OPEN=1
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
